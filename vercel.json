{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/seo?file=sitemap" },
    { "source": "/robots.txt", "destination": "/api/seo?file=robots" },
    { "source": "/((?!api/|assets/).+)", "destination": "/api/page?__path=$1" }
  ],
  "functions": {
    "api/page.js": { "includeFiles": "dist/index.html" }
  }
}
